  "cards": [
    { "dot": "cyan", "title": "Authority Boundary", "items": ["A model proposal is not Operational Authority", "Human Gate approval is checked against the declared approval authority", "READY_TO_RESUME still requires explicit resume authority"] },
    { "dot": "amber", "title": "Uncertainty Is Preserved", "items": ["DISPATCHING is persisted before the adapter performs an external effect", "A successful receipt without required readback becomes EFFECT_UNKNOWN", "Restart recovery moves incomplete dispatch responsibility to EFFECT_UNKNOWN without silent redispatch"] },
    { "dot": "emerald", "title": "Completion Rule", "items": ["Only VERIFIED can transition to COMPLETED", "Reconciliation may establish VERIFIED only with the required evidence", "Repair and Human Return preserve residual ownership rather than erasing it"] }
