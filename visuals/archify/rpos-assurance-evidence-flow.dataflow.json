      { "id": "runtime-route", "label": "Runtime evidence route", "focus": ["source", "tests", "manifest", "viewer"], "note": "Runtime tests remain a separate evidence stream that is cross-referenced rather than collapsed into formal proof." },
      { "id": "authority-ceiling", "label": "Authority ceiling", "focus": ["manifest", "viewer", "human_authority"], "note": "Assurance can inform review but cannot authorize an operation or approve a Human Gate." }
