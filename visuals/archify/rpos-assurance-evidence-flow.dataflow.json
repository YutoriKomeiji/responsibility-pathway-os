  },
  "stages": [
    { "label": "Exact source" },
    { "label": "Independent checks" },
    { "label": "Source-bound evidence" },
    { "label": "Public assurance" },
    { "label": "Operational authority" }
  ],
  "nodes": [
    { "id": "source", "type": "backend", "label": "RPOS Source Commit", "sublabel": "exact Git SHA", "stage": 0, "row": 1, "tag": "source of truth" },
    { "id": "lean", "type": "backend", "label": "Lean 4 Model", "sublabel": "structural invariants", "stage": 1, "row": 0, "tag": "formal" },
    { "id": "tests", "type": "backend", "label": "Runtime Tests", "sublabel": "implementation evidence", "stage": 1, "row": 2, "tag": "runtime" },
    { "id": "machine_check", "type": "security", "label": "Pinned lake build", "sublabel": "checked theorems", "stage": 2, "row": 0, "tag": "Lean" },
